"use strict";
document.addEventListener("click", function(e) {
    // write code here
    var wall = document.querySelector(".wall");
    var spider = wall.querySelector(".spider");
    var rect = wall.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) return;
    var x = e.clientX - rect.left - wall.clientLeft - spider.offsetWidth / 2;
    var y = e.clientY - rect.top - wall.clientTop - spider.offsetHeight / 2;
    var maxLeft = wall.clientWidth - spider.offsetWidth;
    var maxTop = wall.clientHeight - spider.offsetHeight;
    var left = Math.min(maxLeft, Math.max(0, x));
    var fromTop = Math.min(maxTop, Math.max(0, y));
    spider.style.left = "".concat(left, "px");
    spider.style.top = "".concat(fromTop, "px");
});

